      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true">
        <dc:Bounds x="900" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="169" width="160" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="1020" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Room_di" bpmnElement="Room">
        <dc:Bounds x="1125" y="76" width="130" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm">
        <dc:Bounds x="1125" y="294" width="130" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="1315" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Finish_di" bpmnElement="Finish">
        <dc:Bounds x="1415" y="184" width="130" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1762" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1700" y="244" width="160" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NoRoom_di" bpmnElement="NoRoom">
        <dc:Bounds x="565" y="404" width="140" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndNoRoom_di" bpmnElement="EndNoRoom">
        <dc:Bounds x="782" y="422" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="464" width="160" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NoPay_di" bpmnElement="NoPay">
        <dc:Bounds x="860" y="509" width="130" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndNoPay_di" bpmnElement="EndNoPay">
        <dc:Bounds x="1062" y="527" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="569" width="160" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Log_di" bpmnElement="Log">
        <dc:Bounds x="1565" y="184" width="140" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Request_di" bpmnElement="Flow_Start_Request">
        <di:waypoint x="73" y="220"/>
        <di:waypoint x="130" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Request_Dates_di" bpmnElement="Flow_Request_Dates">
        <di:waypoint x="250" y="220"/>
        <di:waypoint x="280" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dates_Available_di" bpmnElement="Flow_Dates_Available">
        <di:waypoint x="400" y="220"/>
        <di:waypoint x="430" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Available_G1_di" bpmnElement="Flow_Available_G1">
        <di:waypoint x="550" y="220"/>
        <di:waypoint x="610" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G1_Pay_di" bpmnElement="Flow_G1_Pay">
        <di:waypoint x="660" y="220"/>
        <di:waypoint x="720" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="682" y="196" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G1_NoRoom_di" bpmnElement="Flow_G1_NoRoom">
        <di:waypoint x="635" y="245"/>
        <di:waypoint x="635" y="404"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="639" y="316.5" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoRoom_EndNoRoom_di" bpmnElement="Flow_NoRoom_EndNoRoom">
        <di:waypoint x="705" y="440"/>
        <di:waypoint x="782" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pay_G2_di" bpmnElement="Flow_Pay_G2">
        <di:waypoint x="840" y="220"/>
        <di:waypoint x="900" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G2_Split_di" bpmnElement="Flow_G2_Split">
        <di:waypoint x="950" y="220"/>
        <di:waypoint x="1020" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="977" y="196" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G2_NoPay_di" bpmnElement="Flow_G2_NoPay">
        <di:waypoint x="925" y="245"/>
        <di:waypoint x="925" y="509"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="929" y="369" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoPay_EndNoPay_di" bpmnElement="Flow_NoPay_EndNoPay">
        <di:waypoint x="990" y="545"/>
        <di:waypoint x="1062" y="545"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Room_di" bpmnElement="Flow_Split_Room">
        <di:waypoint x="1045" y="195"/>
        <di:waypoint x="1045" y="112"/>
        <di:waypoint x="1125" y="112"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Confirm_di" bpmnElement="Flow_Split_Confirm">
        <di:waypoint x="1045" y="245"/>
        <di:waypoint x="1045" y="330"/>
        <di:waypoint x="1125" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Room_Join_di" bpmnElement="Flow_Room_Join">
        <di:waypoint x="1255" y="112"/>
        <di:waypoint x="1340" y="112"/>
        <di:waypoint x="1340" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_Join_di" bpmnElement="Flow_Confirm_Join">
        <di:waypoint x="1255" y="330"/>
        <di:waypoint x="1340" y="330"/>
        <di:waypoint x="1340" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Finish_di" bpmnElement="Flow_Join_Finish">
        <di:waypoint x="1365" y="220"/>
        <di:waypoint x="1415" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Finish_Log_di" bpmnElement="Flow_Finish_Log">
        <di:waypoint x="1545" y="220"/>
        <di:waypoint x="1565" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Log_End_di" bpmnElement="Flow_Log_End">
        <di:waypoint x="1705" y="220"/>
        <di:waypoint x="1762" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
