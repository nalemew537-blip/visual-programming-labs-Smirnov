<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Hotel" targetNamespace="https://example.org/hotel">
  <bpmn:process id="Process_Hotel" name="Бронирование номера в отеле" isExecutable="false">
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>Flow_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Request" name="Получить заявку">
      <bpmn:incoming>Flow_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Dates</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Dates" name="Проверить даты">
      <bpmn:incoming>Flow_Request_Dates</bpmn:incoming>
      <bpmn:outgoing>Flow_Dates_Available</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Available" name="Проверить наличие">
      <bpmn:incoming>Flow_Dates_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_Available_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Номер есть?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Available_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_NoRoom</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pay" name="Обработать оплату">
      <bpmn:incoming>Flow_G1_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Оплата прошла?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pay_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_Split</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_NoPay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_G2_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Room</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Confirm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Room" name="Подготовить номер">
      <bpmn:incoming>Flow_Split_Room</bpmn:incoming>
      <bpmn:outgoing>Flow_Room_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Confirm" name="Отправить подтверждение">
      <bpmn:incoming>Flow_Split_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Join" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Room_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Confirm_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Finish</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Finish" name="Завершить оформление">
      <bpmn:incoming>Flow_Join_Finish</bpmn:incoming>
      <bpmn:outgoing>Flow_Finish_Log</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Бронь оформлена">
      <bpmn:incoming>Flow_Log_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="NoRoom" name="Сообщить: номера нет">
      <bpmn:incoming>Flow_G1_NoRoom</bpmn:incoming>
      <bpmn:outgoing>Flow_NoRoom_EndNoRoom</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndNoRoom" name="Нет номера">
      <bpmn:incoming>Flow_NoRoom_EndNoRoom</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="NoPay" name="Сообщить об ошибке">
      <bpmn:incoming>Flow_G2_NoPay</bpmn:incoming>
      <bpmn:outgoing>Flow_NoPay_EndNoPay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndNoPay" name="Отказ в оплате">
      <bpmn:incoming>Flow_NoPay_EndNoPay</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Log" name="Записать в журнал">
      <bpmn:incoming>Flow_Finish_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Start_Request" sourceRef="Start" targetRef="Request"/>
    <bpmn:sequenceFlow id="Flow_Request_Dates" sourceRef="Request" targetRef="Dates"/>
    <bpmn:sequenceFlow id="Flow_Dates_Available" sourceRef="Dates" targetRef="Available"/>
    <bpmn:sequenceFlow id="Flow_Available_G1" sourceRef="Available" targetRef="G1"/>
    <bpmn:sequenceFlow id="Flow_G1_Pay" sourceRef="G1" targetRef="Pay" name="Да"/>
    <bpmn:sequenceFlow id="Flow_G1_NoRoom" sourceRef="G1" targetRef="NoRoom" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_NoRoom_EndNoRoom" sourceRef="NoRoom" targetRef="EndNoRoom"/>
    <bpmn:sequenceFlow id="Flow_Pay_G2" sourceRef="Pay" targetRef="G2"/>
    <bpmn:sequenceFlow id="Flow_G2_Split" sourceRef="G2" targetRef="Split" name="Да"/>
    <bpmn:sequenceFlow id="Flow_G2_NoPay" sourceRef="G2" targetRef="NoPay" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_NoPay_EndNoPay" sourceRef="NoPay" targetRef="EndNoPay"/>
    <bpmn:sequenceFlow id="Flow_Split_Room" sourceRef="Split" targetRef="Room"/>
    <bpmn:sequenceFlow id="Flow_Split_Confirm" sourceRef="Split" targetRef="Confirm"/>
    <bpmn:sequenceFlow id="Flow_Room_Join" sourceRef="Room" targetRef="Join"/>
    <bpmn:sequenceFlow id="Flow_Confirm_Join" sourceRef="Confirm" targetRef="Join"/>
    <bpmn:sequenceFlow id="Flow_Join_Finish" sourceRef="Join" targetRef="Finish"/>
    <bpmn:sequenceFlow id="Flow_Finish_Log" sourceRef="Finish" targetRef="Log"/>
    <bpmn:sequenceFlow id="Flow_Log_End" sourceRef="Log" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Hotel">
    <bpmndi:BPMNPlane id="Plane_Hotel" bpmnElement="Process_Hotel">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="37" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-25" y="244" width="160" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_di" bpmnElement="Request">
        <dc:Bounds x="130" y="184" width="120" height="72"/>
      </bpmndi:BPMNShape>
