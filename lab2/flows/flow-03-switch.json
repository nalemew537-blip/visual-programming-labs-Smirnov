        "l2-03-sw"
      ]
    ],
    "func": "const values = [2, 4, 6, 8];\nconst input = Number(msg.payload);\nlet sum = 0;\nfor (const value of values) { sum += value; }\nconst result = { student: \"Smirnov\", group: env.get(\"STUDENT_GROUP\") || \"not-set\", input, sum };\nif (input >= 10) { result.category = \"high\"; } else { result.category = \"low\"; }\nmsg.payload = result;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
