    "z": "lab2-tab-08",
    "name": "Ответ items",
    "x": 400,
    "y": 260,
    "wires": [
      [
        "l2-08-itemsres"
      ]
    ],
    "func": "const items = [{id:1,name:\"Book\"},{id:2,name:\"Pen\"}];\nconst q = msg.req.query || {};\nmsg.headers = {\"Content-Type\":\"application/json\"};\nif (q.id === undefined) { msg.statusCode=200; msg.payload=items; }\nelse if (typeof q.id !== \"string\" || !/^[1-9][0-9]*$/.test(q.id) || !Number.isSafeInteger(Number(q.id))) { msg.statusCode=400; msg.payload={error:\"id must be a positive integer\"}; }\nelse { const item=items.find(i=>i.id===Number(q.id)); msg.statusCode=item?200:404; msg.payload=item||{error:\"Item not found\"}; }\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
